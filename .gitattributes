# Normalize text files in repository
* text=auto

# Source/config files: keep LF to avoid noisy diffs across Windows/Linux
*.cj text eol=lf
*.ts text eol=lf
*.ets text eol=lf
*.js text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf

# Scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.hap binary
*.so binary
*.a binary
*.cjo binary
*.ast binary
*.idx binary
*.db binary
*.db-shm binary
*.db-wal binary
